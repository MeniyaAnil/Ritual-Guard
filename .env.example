# Required for Save Proof.
VITE_GUARD_CONTRACT_ADDRESS=0x07454969D362B6c624288ddD87447158fB41BC92

# Optional: turn on Ritual-native LLM proof inside Save Proof.
# The UI stays normal-user friendly. No executor fields are shown.
VITE_ENABLE_RITUAL_NATIVE=false
VITE_RITUAL_EXECUTOR_ADDRESS=0x1e2722e8e19d5783c8Ecf26D3F9789C0b915dB77

# Required by Ritual LLM convoHistory when native mode is enabled.
VITE_CONVO_PLATFORM=gcs
VITE_CONVO_PATH=convos/ritual-guard-session.jsonl
VITE_CONVO_KEY_REF=GCS_CREDS
